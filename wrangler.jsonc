{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "ice-tendy",
	"compatibility_date": "2026-10-29",
	"compatibility_flags": [
		"nodejs_als"
	],
	"account_id": "7f79cc348a72815eea2e88c98b07a4b9",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "ice-tendy",
			"database_id": "4ccf088e-c5a3-49c2-a651-645d3307e90b",
			"migrations_dir": "migrations"
		}
	],
	"workers_dev": true,
	"preview_urls": true,
	"env": {
		// Used only by the schedule scraper (`npm run ingest:remote`, run from GitHub Actions) to
		// reach the production database through the same binding API as local dev. Never deployed.
		"ingest": {
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "ice-tendy",
					// Keep in sync with the database_id above.
					"database_id": "4ccf088e-c5a3-49c2-a651-645d3307e90b",
					"migrations_dir": "migrations",
					"remote": true
				}
			]
		}
	}
}